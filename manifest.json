{
  "manifest_version": 3,
  "name": "Slack Emoji Importer",
  "version": "1.0.0",
  "description": "Search and import emojis from slackemoji.com and slackmojis.com directly into your Slack workspace",
  "permissions": ["activeTab"],
  "host_permissions": [
    "*://*.slack.com/*",
    "https://slackmojis.com/*",
    "https://slackemoji.com/*",
    "https://emojis.slackmojis.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.slack.com/customize/emoji*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
